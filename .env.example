VERIFY_TOKEN=troque_por_um_token_de_verificacao
META_APP_SECRET=troque_pelo_app_secret_da_meta

IG_ACCESS_TOKEN=troque_pelo_access_token
IG_USER_ID=troque_pelo_instagram_user_id

TARGET_MEDIA_ID=troque_pelo_id_do_post
STL_KEYWORD=STL
STL_LINK=https://example.com/download/modelo.stl

GRAPH_VERSION=v26.0
GRAPH_BASE_URL=https://graph.instagram.com
DATABASE_PATH=data/instagram_bot.db
REQUEST_TIMEOUT_SECONDS=20
LOG_LEVEL=INFO

# Opcional: use para varias automacoes.
# Se definido, substitui TARGET_MEDIA_ID/STL_KEYWORD/STL_LINK.
# AUTOMATIONS_JSON=[{"media_id":"180...","keyword":"STL","link":"https://example.com/modelo.stl","active":true}]
