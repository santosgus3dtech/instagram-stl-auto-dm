[Unit]
Description=Instagram personal follow export assistant
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=guusebumps
Group=guusebumps
WorkingDirectory=/opt/instagram-stl-auto-dm
EnvironmentFile=-/opt/instagram-stl-auto-dm/.env
ExecStart=/opt/instagram-stl-auto-dm/.venv/bin/python /opt/instagram-stl-auto-dm/tools/accounts_center_export.py --mode request-export --headless
TimeoutStartSec=8min

[Install]
WantedBy=multi-user.target
